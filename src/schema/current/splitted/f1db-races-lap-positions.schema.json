{
  "$id": "https://www.f1db.com/schema/v6.5.0/splitted/f1db-races-lap-positions.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "F1DB",
  "description": "F1DB Races Lap Positions JSON Schema",
  "type": "array",
  "items": {
    "$ref": "#/definitions/LapPosition"
  },
  "additionalProperties": false,
  "definitions": {
    "LapPosition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raceId": {
          "type": "integer",
          "description": "The identifier of the race."
        },
        "year": {
          "type": "integer",
          "description": "The year of the season."
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "description": "The round number of the race in the season."
        },
        "positionDisplayOrder": {
          "type": "integer",
          "minimum": 1,
          "description": "The position display order of the lap position."
        },
        "lap": {
          "type": "integer",
          "minimum": 0,
          "description": "The lap number (0 = the order at the start, where known)."
        },
        "positionNumber": {
          "type": "integer",
          "minimum": 1,
          "description": "The running position of the driver at the end of the lap."
        },
        "driverNumber": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "The car number of the driver."
        },
        "driverId": {
          "type": "string",
          "description": "The identifier of the driver."
        },
        "constructorId": {
          "type": "string",
          "description": "The identifier of the constructor."
        },
        "engineManufacturerId": {
          "type": "string",
          "description": "The identifier of the engine manufacturer."
        },
        "tyreManufacturerId": {
          "type": "string",
          "description": "The identifier of the tyre manufacturer."
        }
      },
      "required": [
        "raceId",
        "year",
        "round",
        "positionDisplayOrder",
        "lap",
        "positionNumber",
        "driverNumber",
        "driverId",
        "constructorId",
        "engineManufacturerId",
        "tyreManufacturerId"
      ]
    }
  }
}
